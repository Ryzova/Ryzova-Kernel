# Source once in the guest terminal: . /rc/lib/ryz-env
# ryz env linux|windows|macos
# ryz run <arguments to the selected Compact launcher>
fn ryz {
	switch($"1){
	case help
		echo 'ryz env TARGET                 select a launcher'
		echo 'ryz env trans WORKFLOW TARGET  select workflow and launcher'
		echo 'ryz status                     show session and directory'
		echo 'ryz run ARGS                   invoke selected Compact launcher'
		echo 'Available environments: windows macos linux'
	case status
		if(~ $#ryzenv 0) echo 'No environment selected'
		if not {
			echo workflow $ryzworkflow
			echo target $ryzenv
		}
		pwd
	case env
		if(~ $#* 4 && ~ $2 trans && ~ $3 windows macos linux && ~ $4 windows macos linux){
			ryzworkflow=$3
			ryzenv=$4
			prompt=('ryz['^$ryzworkflow^'->'^$ryzenv^']> ' '    ')
			status=''
		}
		if not if(! ~ $#* 2){
			echo 'usage: ryz env linux|windows|macos' >[1=2]
			status=usage
		}
		if not switch($2){
		case linux windows macos
			ryzworkflow=$2
			ryzenv=$2
			prompt=('ryz['^$ryzenv^']> ' '    ')
			status=''
		case *
			echo 'unknown Ryzova environment:' $2 >[1=2]
			status=usage
		}
	case run
		shift
		if(~ $#* 0){
			echo 'usage: ryz run <compact launcher arguments>' >[1=2]
			status=usage
		}
		if not switch($"ryzenv){
		case linux
			/amd64/bin/compact-linux $*
		case windows
			/amd64/bin/compact-windows $*
		case macos
			/amd64/bin/compact-macos-m8 --run $*
		case *
			echo 'select an environment with ryz env first' >[1=2]
			status=usage
		}
	case *
		echo 'unknown command; type ryz help' >[1=2]
		status=usage
	}
}
